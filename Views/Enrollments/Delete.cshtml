@model Enrollment
@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>
<h3>¿Seguro que deseas eliminar esta matrícula?</h3>
<dl class="row">
    <dt class="col-sm-2">Estudiante</dt>
    <dd class="col-sm-10">@Model.Student?.FirstName @Model.Student?.LastName</dd>
    <dt class="col-sm-2">Curso</dt>
    <dd class="col-sm-10">@Model.Course?.Name</dd>
    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Date.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdEnrollment" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</form>
