@model Student
@{
    ViewData["Title"] = "Eliminar";
}

<h1>Eliminar</h1>
<h3>¿Seguro que deseas eliminar este estudiante?</h3>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<dl class="row">
    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Grade</dt>
    <dd class="col-sm-10">@Model.Grade?.Name</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdStudent" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</form>
